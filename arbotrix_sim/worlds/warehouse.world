<?xml version="1.0"?>
<sdf version="1.6">
  <world name="arbotrix_warehouse">
    <!-- Lower physics rate for a 2-core VM while remaining adequate for 5 Hz Nav2 control. -->
    <physics name="vm_physics" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_update_rate>100</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
      <ode><solver><type>quick</type><iters>20</iters><sor>1.3</sor></solver></ode>
    </physics>

    <scene><ambient>0.45 0.45 0.45 1</ambient><background>0.75 0.78 0.82 1</background><shadows>false</shadows></scene>
    <light name="warehouse_light" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <direction>-0.2 0.1 -1</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 10 0.05</size></box></geometry><pose>0 0 -0.025 0 0 0</pose></collision>
        <visual name="visual"><geometry><box><size>12 10 0.05</size></box></geometry><pose>0 0 -0.025 0 0 0</pose><material><ambient>0.72 0.72 0.72 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 12 m x 10 m room; walls are 0.15 m thick. -->
    <model name="north_wall"><static>true</static><pose>0 4.925 0.6 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>12 0.15 1.2</size></box></geometry></collision><visual name="v"><geometry><box><size>12 0.15 1.2</size></box></geometry><material><diffuse>0.35 0.35 0.38 1</diffuse></material></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -4.925 0.6 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>12 0.15 1.2</size></box></geometry></collision><visual name="v"><geometry><box><size>12 0.15 1.2</size></box></geometry><material><diffuse>0.35 0.35 0.38 1</diffuse></material></visual></link></model>
    <model name="east_wall"><static>true</static><pose>5.925 0 0.6 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.15 10 1.2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 10 1.2</size></box></geometry><material><diffuse>0.35 0.35 0.38 1</diffuse></material></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-5.925 0 0.6 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.15 10 1.2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 10 1.2</size></box></geometry><material><diffuse>0.35 0.35 0.38 1</diffuse></material></visual></link></model>

    <!-- Four shelves leave a central aisle and broad outer lanes. -->
    <model name="shelf_1"><static>true</static><pose>-2.5 1.5 0.6 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>2.4 0.55 1.2</size></box></geometry></collision><visual name="v"><geometry><box><size>2.4 0.55 1.2</size></box></geometry><material><diffuse>0.55 0.34 0.12 1</diffuse></material></visual></link></model>
    <model name="shelf_2"><static>true</static><pose>2.5 1.5 0.6 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>2.4 0.55 1.2</size></box></geometry></collision><visual name="v"><geometry><box><size>2.4 0.55 1.2</size></box></geometry><material><diffuse>0.55 0.34 0.12 1</diffuse></material></visual></link></model>
    <model name="shelf_3"><static>true</static><pose>-2.5 -1.2 0.6 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>2.4 0.55 1.2</size></box></geometry></collision><visual name="v"><geometry><box><size>2.4 0.55 1.2</size></box></geometry><material><diffuse>0.55 0.34 0.12 1</diffuse></material></visual></link></model>
    <model name="shelf_4"><static>true</static><pose>2.5 -1.2 0.6 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>2.4 0.55 1.2</size></box></geometry></collision><visual name="v"><geometry><box><size>2.4 0.55 1.2</size></box></geometry><material><diffuse>0.55 0.34 0.12 1</diffuse></material></visual></link></model>

    <!-- Floor-only visual station markers; no collisions. -->
    <model name="station_A"><static>true</static><pose>-4 4 0.006 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.28</radius><length>0.01</length></cylinder></geometry><material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material></visual></link></model>
    <model name="station_B"><static>true</static><pose>0 4 0.006 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.28</radius><length>0.01</length></cylinder></geometry><material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material></visual></link></model>
    <model name="station_C"><static>true</static><pose>4 4 0.006 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.28</radius><length>0.01</length></cylinder></geometry><material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material></visual></link></model>
    <model name="drop_1"><static>true</static><pose>-4 -4 0.006 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.28</radius><length>0.01</length></cylinder></geometry><material><ambient>0.85 0 0 1</ambient><diffuse>0.85 0 0 1</diffuse></material></visual></link></model>
    <model name="drop_2"><static>true</static><pose>0 -4 0.006 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.28</radius><length>0.01</length></cylinder></geometry><material><ambient>0.85 0 0 1</ambient><diffuse>0.85 0 0 1</diffuse></material></visual></link></model>
    <model name="drop_3"><static>true</static><pose>4 -4 0.006 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.28</radius><length>0.01</length></cylinder></geometry><material><ambient>0.85 0 0 1</ambient><diffuse>0.85 0 0 1</diffuse></material></visual></link></model>
    <model name="home_base"><static>true</static><pose>0 -3.5 0.008 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.22</radius><length>0.012</length></cylinder></geometry><material><ambient>0 0.25 1 1</ambient><diffuse>0 0.25 1 1</diffuse></material></visual></link></model>

  </world>
</sdf>
